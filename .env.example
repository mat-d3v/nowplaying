# Copy to .env: mpd-bridge.py reads it at startup. Variables set in the
# environment (shell, systemd, Docker) take precedence over this file.

# Optional: Last.fm API key, artwork fallback when mpd has none
# (free at https://www.last.fm/api). Leave empty to disable.
LASTFM_API_KEY=

# mpd password, if mpd.conf sets one
# MPD_PASSWORD=

# Artwork from the iTunes Search API, for radios and tracks mpd has no
# artwork for (only the artist, title and album are sent). 0 turns it off.
# ITUNES_ARTWORK=1

# AirPlay: shairport-sync's metadata pipe (see the README); empty turns
# AirPlay off
# SHAIRPORT_PIPE=/tmp/shairport-sync-metadata

# Spotify Connect: what librespot (raspotify) plays, from the events
# spotify-event.py passes on (see the README). 0 turns it off
# SPOTIFY=1

# HTTPS: certificate and private key (PEM), paths relative to this folder,
# e.g. made with mkcert (see the README)
# TLS_CERT=nowplaying.pem
# TLS_KEY=nowplaying-key.pem

# Defaults - uncomment to change
# MPD_HOST=127.0.0.1
# MPD_PORT=6600
# PORT=8766
# ALSA_CARD=0
